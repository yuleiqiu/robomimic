{
    "algo_name": "lan_o3dp",
    "experiment": {
        "name": "lan_o3dp_can_abs_pose_sample_paper256_hires_continuous_seed42",
        "validate": true,
        "logging": {
            "terminal_output_to_txt": true,
            "log_tb": true,
            "log_wandb": true,
            "wandb_proj_name": "lan_o3dp_paper_aligned"
        },
        "save": {
            "enabled": true,
            "every_n_seconds": null,
            "every_n_epochs": 50,
            "epochs": [],
            "on_best_validation": false,
            "on_best_rollout_return": false,
            "on_best_rollout_success_rate": true,
            "rollout_success_tiebreak_validation": true,
            "latest_every_n_epochs": 50
        },
        "epoch_every_n_steps": null,
        "validation_epoch_every_n_steps": null,
        "render_video": false,
        "rollout": {
            "enabled": true,
            "n": 20,
            "horizon": 400,
            "rate": 50,
            "warmstart": 0,
            "terminate_on_success": true
        }
    },
    "train": {
        "data": [{
            "path": "third_party/robomimic/datasets/can/yq/image_v15_abs_eef_pose_osc_lan40_paper256_hires_continuous.hdf5"
        }],
        "output_dir": "../../../outputs/robomimic/train",
        "normalize_weights_by_ds_size": false,
        "num_data_workers": 0,
        "hdf5_cache_mode": "low_dim",
        "hdf5_use_swmr": true,
        "hdf5_load_next_obs": false,
        "hdf5_normalize_obs": true,
        "hdf5_filter_key": "train",
        "hdf5_validation_filter_key": "valid",
        "seq_length": 16,
        "pad_seq_length": true,
        "frame_stack": 2,
        "pad_frame_stack": true,
        "dataset_keys": ["abs_eef_pose_action", "rewards", "dones"],
        "action_keys": ["abs_eef_pose_action"],
        "action_config": {
            "abs_eef_pose_action": {"normalization": "min_max"}
        },
        "observation_config": {
            "agent_pos": {"normalization": "min_max", "last_n_dims": 1},
            "task_pointcloud": {"normalization": "min_max", "last_n_dims": 1}
        },
        "goal_mode": null,
        "cuda": true,
        "batch_size": 64,
        "num_epochs": 500,
        "seed": 42,
        "max_grad_norm": null
    },
    "algo": {
        "optim_params": {
            "policy": {
                "optimizer_type": "adamw",
                "learning_rate": {
                    "initial": 0.0001,
                    "decay_factor": 0.1,
                    "step_every_batch": true,
                    "scheduler_type": "cosine",
                    "num_cycles": 0.5,
                    "warmup_steps": 300,
                    "epoch_schedule": []
                },
                "regularization": {"L2": 0.000001},
                "optimizer_kwargs": {"betas": [0.95, 0.999], "eps": 1e-08}
            }
        },
        "horizon": {
            "observation_horizon": 2,
            "action_horizon": 8,
            "prediction_horizon": 16
        },
        "unet": {
            "enabled": true,
            "diffusion_step_embed_dim": 128,
            "down_dims": [512, 1024, 2048],
            "kernel_size": 5,
            "n_groups": 8,
            "cond_predict_scale": true
        },
        "ema": {"enabled": true, "power": 0.75},
        "ddpm": {
            "enabled": true,
            "num_train_timesteps": 100,
            "num_inference_timesteps": 100,
            "beta_schedule": "squaredcos_cap_v2",
            "clip_sample": true,
            "prediction_type": "sample"
        },
        "ddim": {"enabled": false}
    },
    "observation": {
        "modalities": {
            "obs": {
                "low_dim": ["agent_pos"],
                "rgb": [],
                "depth": [],
                "scan": ["task_pointcloud"]
            },
            "goal": {"low_dim": [], "rgb": [], "depth": [], "scan": []}
        },
        "encoder": {
            "scan": {
                "core_class": "LanO3DPPointCloudCore",
                "core_kwargs": {},
                "obs_randomizer_class": null,
                "obs_randomizer_kwargs": {}
            }
        }
    }
}
